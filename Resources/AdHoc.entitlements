<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Resources/Cuadro.entitlements, which builds signed with an Apple identity get. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Builds without a team ID only, ad-hoc or self-signed (see the Makefile): library
	     validation would refuse to load the embedded Sparkle.framework. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
