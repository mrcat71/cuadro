<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Resources/Cuadro.entitlements, which builds signed with a real identity get. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Ad-hoc builds only (see the Makefile): an ad-hoc signature has no team ID, so library
	     validation would refuse to load the embedded Sparkle.framework. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
